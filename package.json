{
  "name": "intra-reimagined",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "IR_ENTRY=background vite build --mode development && vite build --watch --mode development",
    "build": "tsc --noEmit && rm -rf dist && vite build && IR_ENTRY=background vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "run:desktop": "web-ext run",
    "run:android": "web-ext run -t firefox-android",
    "release": "node scripts/release.mjs",
    "package": "node scripts/release.mjs --manual",
    "server": "pnpm --dir server start",
    "server:up": "docker compose -f server/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "web-ext": "^10.8.0"
  }
}
