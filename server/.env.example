# Copy to server/.env (gitignored). Used by `docker compose` and by `pnpm start` (local run).

# 42 API app: https://profile.intra.42.fr/oauth/applications/new
FT_UID=
FT_SECRET=

# Postgres (docker compose creates it with these)
POSTGRES_USER=intra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intra_reimagined

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels); public hostname → http://app:8787
CLOUDFLARE_TUNNEL_TOKEN=

# Origins allowed to call the API (the intra pages the extension runs on)
ALLOWED_ORIGINS=https://profile.intra.42.fr

# Local run without Docker only:
# PORT=8787
# HOST=127.0.0.1
# DATABASE_URL=postgres://intra:change-me@127.0.0.1:5432/intra_reimagined
# TRUST_PROXY=
