# Copy to server/.env (gitignored).
# 42 API app: https://profile.intra.42.fr/oauth/applications/new (no redirect/scopes needed beyond "public").
FT_UID=
FT_SECRET=
PORT=8787
# 127.0.0.1 for local use; 0.0.0.0 on a server (ideally behind an HTTPS reverse proxy).
HOST=127.0.0.1
# Origins allowed to call the API (the intra pages the extension runs on).
ALLOWED_ORIGINS=https://profile.intra.42.fr
# Set to 1 behind a reverse proxy so rate limiting uses X-Forwarded-For.
TRUST_PROXY=
