# Copy to server/.env (gitignored). Used by `docker compose` and by `pnpm start` (local run).

# 42 API app: https://profile.intra.42.fr/oauth/applications/new
FT_UID=
FT_SECRET=
# Its redirect URI must be <PUBLIC_URL>/auth/callback (login with 42; the /v1 API needs it).

# Public URL of this server, and the key that signs login tokens (openssl rand -hex 32;
# changing it signs everyone out).
PUBLIC_URL=https://intra.mthan.dev
AUTH_SECRET=

# Postgres (docker compose creates it with these)
POSTGRES_USER=intra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intra_reimagined

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels); public hostname → http://app:8787
CLOUDFLARE_TUNNEL_TOKEN=

# Origins allowed to call the API (the intra pages the extension runs on)
ALLOWED_ORIGINS=https://profile.intra.42.fr,https://projects.intra.42.fr
# Logins (comma-separated) that can delete anyone's project comment.
ADMIN_LOGINS=

# Local run without Docker only:
# PORT=8787
# HOST=127.0.0.1
# DATABASE_URL=postgres://intra:change-me@127.0.0.1:5432/intra_reimagined
# TRUST_PROXY=
