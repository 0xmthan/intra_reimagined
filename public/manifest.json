{
  "manifest_version": 3,
  "name": "Intra Reimagined",
  "description": "A modern, mobile-friendly redesign of the 42 intra profile page.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.intra.42.fr/*",
    "https://pace-system.42.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.intra.42.fr/*"
      ],
      "exclude_matches": [
        "https://profile-v3.intra.42.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://profile-v3.intra.42.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "intra-reimagined@mthan",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      },
      "update_url": "https://intra.mthan.dev/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "clusters-embed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  }
}
