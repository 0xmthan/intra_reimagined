# Copy to .env.release (gitignored) and fill in.
# AMO API credentials: https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=
# Where the signed releases are served from, and where `pnpm release` copies them (scp target).
IR_UPDATES_BASE=https://intra.mthan.dev
IR_DEPLOY=syn-local:Documents/intra-reimagined/releases
